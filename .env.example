NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional private capture helper. Keep these server-only.
CAPTURE_TOKEN=
CAPTURE_OWNER_EMAIL=
CAPTURE_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing. Keep every STRIPE_SECRET_KEY and webhook secret server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
STRIPE_TRIAL_DAYS=0
STRIPE_AUTOMATIC_TAX=false
# Hosted "links" mode: Stripe Payment Links and the no-code portal login link.
# Used when STRIPE_SECRET_KEY is absent; the webhook secret is still required.
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_QUARTERLY=
STRIPE_PAYMENT_LINK_ANNUAL=
STRIPE_PORTAL_LOGIN_URL=
BILLING_REQUIRED=false
BILLING_GRACE_DAYS=3
BILLING_TERMS_READY=false

# Public display values. Checkout remains authoritative for the actual charge.
NEXT_PUBLIC_BILLING_MONTHLY_CAD=59
NEXT_PUBLIC_BILLING_QUARTERLY_CAD=79
NEXT_PUBLIC_BILLING_ANNUAL_CAD=159
NEXT_PUBLIC_SUPPORT_EMAIL=fuanne_gm@hotmail.com

# Coaching: comma-separated emails allowed to open /coaching/admin.
COACHING_ADMIN_EMAILS=

# Admin panel (/admin): comma-separated emails allowed in. Empty disables the panel.
ADMIN_EMAILS=

# iOS install link (TestFlight public link during beta, App Store URL later); footer link hidden when unset
NEXT_PUBLIC_IOS_APP_URL=
